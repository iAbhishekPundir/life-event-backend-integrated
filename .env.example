# ---------------------------------------------------------------------------
# LLM - OpenAI-compatible chat completions endpoint.
# The service is provider-agnostic; pick ONE of the options below.
#
# Option A (recommended, free + open source): Ollama running locally
#   Install:  https://ollama.com
#   Then:     ollama pull gemma2      (or llama3.1, mistral, phi3)
#             ollama serve
# LLM_API_URL=http://localhost:11434/v1/chat/completions
# LLM_MODEL_NAME=gemma2
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=60

LLM_API_URL=
LLM_MODEL_NAME=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=

# Option B (free + open source, self-hosted for a team): vLLM
# LLM_API_URL=http://<your-vllm-host>:8000/v1/chat/completions
# LLM_MODEL_NAME=google/gemma-2-9b-it
# LLM_API_KEY=

# Option C: any hosted OpenAI-compatible gateway (NOTE: these are paid)
# LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_MODEL_NAME=google/gemma-2-9b-it
# LLM_API_KEY=your-key-here



# If no LLM is reachable, the application still works end to end - narrative
# fields fall back to deterministic text derived from the rules engine.
